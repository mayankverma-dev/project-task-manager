PORT=5000
DATABASE_URL=postgres://postgres:password@localhost:5432/project_task_manager
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecretjwtkey
JWT_EXPIRES_IN=15m
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── SMTP (Nodemailer) ─────────────────────────────────────────────────────────
# Required for the worker process to send real emails.
# If these are absent, the worker will log a warning and skip email sends (fail-open).
# Compatible with any SMTP provider: Gmail (App Password), Mailtrap, Resend, SendGrid, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Project Task Manager <no-reply@example.com>"